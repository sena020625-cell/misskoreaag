# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 공유·커밋하지 마세요.

# 사용할 TTS 공급자: elevenlabs (기본) | typecast | per_line (줄별 합성형 대안)
TTS_PROVIDER=elevenlabs

# --- Typecast (타입캐스트) --- TTS_PROVIDER=typecast 일 때
# API 키는 https://studio.typecast.ai/developers/api 에서 발급합니다(개인 구독과 별도의 API 요금제가 필요할 수 있습니다).
# TYPECAST_API_KEY=
# 채널 고정 보이스 ID (tc_ 로 시작하는 기본 보이스 또는 uc_ 로 시작하는 커스텀 보이스)
# TYPECAST_VOICE_ID=
# TYPECAST_MODEL=ssfm-v30
# TYPECAST_LANGUAGE=kor
# 선택: 감정. smart(문맥 자동, ssfm-v30 전용) 또는 normal, happy, sad, angry, whisper, toneup, tonedown
# TYPECAST_EMOTION=
# TYPECAST_EMOTION_INTENSITY=1
# 선택: 속도 0.5~2, 음높이 -12~12(정수), 음량 0~200(정수) 또는 목표 LUFS -70~0 (음량과 LUFS는 함께 쓸 수 없음)
# TYPECAST_TEMPO=
# TYPECAST_PITCH=
# TYPECAST_VOLUME=
# TYPECAST_TARGET_LUFS=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# 채널 고정 보이스 ID (채널 톤 유지를 위해 팀 전원이 같은 값을 씁니다)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# 선택: 목소리 설정. 비워두면 보이스 기본값을 씁니다. (0~1, speed는 0.7~1.2)
# ELEVENLABS_STABILITY=
# ELEVENLABS_SIMILARITY=
# ELEVENLABS_STYLE=
# ELEVENLABS_SPEED=

# --- 대안: per_line (TTS_PROVIDER=per_line 일 때만) ---
# 글자 타이밍을 주지 않는 TTS를 줄 단위로 합성해 이어 붙입니다. 백엔드: openai | typecast
# (typecast 를 쓰면 위의 TYPECAST_* 값을 그대로 씁니다. 글자 타이밍 정렬이 맞지 않을 때의 대안입니다.)
# PER_LINE_BACKEND=openai
# PER_LINE_GAP=0.25
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
