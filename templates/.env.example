# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 공유·커밋하지 마세요.

# 사용할 TTS 공급자: elevenlabs (기본) | per_line (줄별 합성형 대안)
TTS_PROVIDER=elevenlabs

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# 채널 고정 보이스 ID (채널 톤 유지를 위해 팀 전원이 같은 값을 씁니다)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# 선택: 목소리 설정. 비워두면 보이스 기본값을 씁니다. (0~1, speed는 0.7~1.2)
# ELEVENLABS_STABILITY=
# ELEVENLABS_SIMILARITY=
# ELEVENLABS_STYLE=
# ELEVENLABS_SPEED=

# --- 대안: per_line (TTS_PROVIDER=per_line 일 때만) ---
# 글자 타이밍을 주지 않는 TTS를 줄 단위로 합성해 이어 붙입니다.
# PER_LINE_BACKEND=openai
# PER_LINE_GAP=0.25
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
